---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, parseInlineMarkdown } from '../../data/blog';

const posts = [...blogPosts].sort(
    (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

const monthDay = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

const entries = posts.map((post) => ({ ...post, year: post.date.slice(0, 4) }));

const years = [...new Set(entries.map((entry) => entry.year))].map((year) => ({
  year,
  entries: entries.filter((entry) => entry.year === year),
}));
---

<Layout
  title="Blog — Bliss and Innocence"
  description="News and updates from Bliss and Innocence releases, artists, submissions, and label announcements."
  image="/B&I-logo.jpg"
  url="/blog/"
>
  <main class="blog-page">
    <div class="blog-content">

      <h1>
        <span class="title-decoration">//// </span>
        Blog
        <span class="title-decoration"> ////</span>
      </h1>

      <div class="blog-list">
        {years.map((group) => (
          <section class="blog-year">
            <h2 class="year-heading">{group.year}</h2>

            <div class="year-posts">
              {group.entries.map((post) => (
                <article class="blog-post">
                  <div class="blog-meta">
                    <time class="blog-date" datetime={post.date}>{monthDay(post.date)}</time>
                    {post.announcer ? <span class="blog-announcer">{post.announcer}</span> : null}
                  </div>

                  <div class="blog-post-content">
                    {post.title ? <h3>{post.title}</h3> : null}

                    {post.message ? (
                      <p class="blog-preview" set:html={parseInlineMarkdown(post.message)} />
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

    </div>
  </main>
</Layout>

<script>
  const list = document.querySelector<HTMLElement>('.blog-list');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (list && canHover) {
    list.classList.add('blog-reactive');

    const posts = list.querySelectorAll<HTMLElement>('.blog-post');
    const activate = (active: HTMLElement) => {
      posts.forEach((post) => post.classList.toggle('is-active', post === active));
    };

    if (posts[0]) activate(posts[0]);

    posts.forEach((post) => {
      post.addEventListener('mouseenter', () => activate(post));
      post.addEventListener('focusin', () => activate(post));
    });
  }
</script>

<style>
  .blog-page {
    width: 100%;
    max-width: 1120px;
    margin: 4.5rem auto;
    padding: 64px 24px 120px;
    box-sizing: border-box;
  }

  .blog-page h1 {
    width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-size: 1.5rem;
    font-weight: lighter;
  }

  .blog-list {
    width: 100%;
    max-width: 880px;
    margin: 96px auto 0;
  }

  .blog-year {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    column-gap: 40px;
    margin-bottom: 72px;
  }

  .year-heading {
    position: sticky;
    top: 96px;
    align-self: start;
    margin: 0;
    font-size: 2.4rem;
    font-weight: 200;
    letter-spacing: 0.04em;
    opacity: 0.35;
  }

  .year-posts {
    position: relative;
    padding-left: 32px;
    border-left: 1px solid rgba(17, 17, 17, 0.14);
  }

  .blog-post {
    position: relative;
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    column-gap: 28px;
    padding-bottom: 64px;
  }

  .blog-post:last-child {
    padding-bottom: 0;
  }

  .blog-post::before {
    content: "";
    position: absolute;
    left: -36px;
    top: 0.45rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #111;
  }

  .blog-meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 0.2rem;
  }

  .blog-date {
    font-weight: lighter;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .blog-announcer {
    font-weight: lighter;
    font-size: 0.85rem;
    font-style: italic;
    opacity: 0.55;
  }

  .blog-post h3 {
    margin: 0 0 16px;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: lighter;
    line-height: 1.3;
  }

  .blog-preview {
    max-width: 65ch;
    margin: 0;
    line-height: 1.8;
    font-weight: lighter;
    opacity: 0.8;
    overflow-wrap: anywhere;
  }

  .blog-reactive .blog-post {
    opacity: 0.3;
    transition: opacity 0.25s ease;
  }

  .blog-reactive .blog-post.is-active,
  .blog-reactive .blog-post:focus-within {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-reactive .blog-post {
      transition: none;
    }
  }
  :global(.blog-preview a) {
    position: relative;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(17, 17, 17, 0.28);
    text-underline-offset: 3px;
    transition: opacity 0.2s ease, text-decoration-color 0.2s ease;
  }

  :global(.blog-preview a):hover {
    opacity: 0.65;
    text-decoration-color: currentColor;
  }

  @media (max-width: 820px) {
    .blog-year {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }

    .year-heading {
      position: static;
      font-size: 1.8rem;
    }
  }

  @media (max-width: 640px) {
    .blog-page {
      margin: 2rem auto;
      padding: 32px 16px 72px;
    }

    .blog-page h1 {
      font-size: 1.25rem;
      white-space: nowrap;
    }

    .blog-list {
      margin-top: 64px;
    }

    .year-posts {
      padding-left: 20px;
    }

    .blog-post {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
      padding-bottom: 48px;
    }

    .blog-post::before {
      left: -24px;
    }

    .blog-meta {
      flex-direction: row;
      align-items: baseline;
      gap: 20px;
    }
  }
</style>











