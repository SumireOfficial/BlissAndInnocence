---
import Layout from '../../layouts/Layout.astro';
import { people } from '../../data/people';
import { getReleaseCoverImage, releases } from '../../data/releases';

const slugify = (value: string) =>
value
.trim()
.toLowerCase()
.replace(/[^a-z0-9]+/g, '-')
.replace(/^-+|-+$/g, '') || 'person';

const resolvePersonByName = (name?: string) => {
    if (!name || !name.trim()) {
    return null;
    }

    const target = name.trim();

    return people.find((person) => {
    const normalizedPersonName = person.name.trim();

    return (
        person.slug === target ||
            person.slug === slugify(target) ||
            normalizedPersonName.toLowerCase() === target.toLowerCase() ||
            slugify(normalizedPersonName) === slugify(target)
        );
    }) ?? null;
    };

const getPersonLink = (name?: string) => {
    const person = resolvePersonByName(name);

    if (!name || !name.trim()) {
    return { href: null, label: 'Unknown' };
    }

    if (person) {
    return {
        href: `/team/${person.slug}`,
        label: person.name,
        };
    }

    return {
    href: null,
    label: name.trim(),
    };
    };

const getTrackUrl = (
track: { links?: Array<{ url?: string }> } | undefined,
) => {
    const url = track?.links?.find(
    (link) =>
        typeof link.url === 'string' &&
            link.url.trim().length > 0,
    )?.url;

    return typeof url === 'string' ? url : null;
    };

export function getStaticPaths() {
    return releases.map((release) => ({
    params: { slug: release.slug },
    }));
    }

const { slug } = Astro.params;
const release = releases.find((entry) => entry.slug === slug);

if (!release) {
    throw new Error(`Release not found for slug: ${slug}`);
    }

const releaseCoverImage = getReleaseCoverImage(release);
const mediaSections = release.trackCategories?.length
  ? release.trackCategories.map((category, index) => ({
      id: `track-category-${index}`,
      title: category.name,
      tracks: category.tracks ?? [],
      coverImage: getReleaseCoverImage(release, category),
      coverAlt: `${release.title} ${category.name} cover artwork`,
      theme: category.theme,
    }))
  : release.tracks?.length
    ? [{
        id: 'tracks',
        title: 'Tracks',
        tracks: release.tracks,
        coverImage: releaseCoverImage,
        coverAlt: `${release.title} cover artwork`,
      }]
    : [];

const releaseIconMap: Record<string, string> = {
  bandcamp: '/social media/bandcamp.webp',
  youtube: '/social media/youtube.svg',
  x: '/social media/x.svg',
  spotify: '/social media/spotify.svg',
  soundcloud: '/social media/soundcloud.svg',
  linktree: '/social media/linktree.svg',
};

const releaseLinks = (release.links ?? []).filter((link) => {
  const platform =
      typeof link.platform === 'string'
          ? link.platform.toLowerCase()
          : '';

  return !!link.url && !!releaseIconMap[platform];
});

const siteUrl = 'https://blissandinnocence.art';
const releaseSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: release.title,
  url: `${siteUrl}/releases/${release.slug}/`,
  image: `${siteUrl}${releaseCoverImage}`,
  datePublished: release.releaseDate,
  byArtist: {
    '@type': 'MusicGroup',
    name: release.releaseTag === 'xenodigitrecords' ? 'Xenodigit Records' : 'Bliss and Innocence',
  },
};
---

<Layout
    title={`${release.title} — Bliss and Innocence`}
    description={release.description ?? `Listen to ${release.title} from Bliss and Innocence.`}
    image={releaseCoverImage}
    url={`/releases/${release.slug}/`}
    schema={releaseSchema}
>
  <main class="release-page">

    <!-- Release information -->
    <section class="release-info">
      <div class="release-info-inner">

        <div class="title-row">
          <h1>{release.title}</h1>

          {releaseLinks.length > 0 ? (
              <div class="release-links" aria-label="Release links">
                {releaseLinks.map((link) => {
                  const key =
                      typeof link.platform === 'string'
                          ? link.platform.toLowerCase()
                          : 'link';

                  const icon =
                      releaseIconMap[key] ?? '/social media/portfolio.svg';

                  return (
                      <a
                          class="release-link"
                          href={link.url}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={key}
                      >
                        <img
                            src={icon}
                            alt={key}
                            width="24"
                            height="24"
                            loading="lazy"
                            decoding="async"
                        />
                      </a>
                  );
                })}
              </div>
          ) : null}
        </div>

        {release.releaseDate ? (
            <p class="release-meta">{release.releaseDate}</p>
        ) : null}

        {release.catalogNumber ? (
            <p class="release-meta">{release.catalogNumber}</p>
        ) : null}

        {release.description ? (
            <p class="release-description">{release.description}</p>
        ) : null}

        {release.credits && release.credits.length > 0 ? (
            <section class="misc-credits">
              {release.credits.map((credit) => {
                const personRef = getPersonLink(credit.name);

                return (
                    <p class="credit-line">
                      {credit.role
                          ? `${credit.role.toLowerCase()} by:`
                          : 'Credit:'}{' '}

                      {personRef.href ? (
                          <a
                              href={personRef.href}
                              class="person-link"
                          >
                            {personRef.label}
                          </a>
                      ) : (
                          <span>{personRef.label}</span>
                      )}
                    </p>
                );
              })}
            </section>
        ) : null}

      </div>
    </section>

    {mediaSections.map((section) => (
        <section
            class:list={['media-section', { 'media-section-dark': section.theme === 'dark' }]}
            aria-labelledby={`${section.id}-title`}
        >
          <div class="media-layout">
            <section class="track-panel">
              <h2 id={`${section.id}-title`}>{section.title}</h2>

              {section.tracks.length > 0 ? (
                <ul class="track-list">
                {section.tracks.map((track) => {
                  const trackUrl = getTrackUrl(track);
                  const artistNames = Array.isArray(track.artists)
                      ? track.artists
                      : [];

                  return (
                      <li>

                        <div class="track-main">
                      <span class="track-title">
                        {trackUrl ? (
                            <a
                                href={trackUrl}
                                target="_blank"
                                rel="noreferrer"
                                class="track-link"
                            >
                              {track.title}
                            </a>
                        ) : (
                            track.title
                        )}
                      </span>

                          {track.duration ? (
                              <>
                                <span class="track-dash" aria-hidden="true"></span>
                                <span class="track-duration">
                            {track.duration}
                          </span>
                              </>
                          ) : null}
                        </div>

                        <div class="track-credit">
                          {artistNames.length > 0 ? (
                              artistNames.map((artistName, index) => {
                                const personRef = getPersonLink(artistName);

                                return (
                                    <>
                                      {personRef.href ? (
                                          <a href={personRef.href} class="person-link">
                                            {personRef.label}
                                          </a>
                                      ) : (
                                          <span>{personRef.label}</span>
                                      )}

                                      {index < artistNames.length - 1 ? ', ' : ''}
                                    </>
                                );
                              })
                          ) : (
                              <span>Unknown</span>
                          )}
                        </div>

                      </li>
                  );
                })}
                </ul>
              ) : null}
            </section>

            <div class="cover-panel">
              <button
                  type="button"
                  class="cover-image-container"
                  aria-label={`View ${section.title} cover art`}
              >
                <img
                    src={section.coverImage}
                    alt={section.coverAlt}
                    class="release-cover"
                    width="auto"
                    height="auto"
                    loading="lazy"
                    decoding="async"
                />

                <span class="cover-overlay">
                  View cover art
                </span>
              </button>
            </div>
          </div>
        </section>
    ))}

    <!-- Cover modal -->
    {mediaSections.length > 0 ? <div id="cover-modal" class="cover-modal" aria-hidden="true">
      <div
          class="cover-modal-backdrop"
          data-close-cover-modal="true"
      ></div>

      <div class="cover-modal-content">
        <img
            id="cover-modal-image"
            src={mediaSections[0].coverImage}
            alt={`${mediaSections[0].coverAlt} preview`}
            class="cover-modal-image"
            width="900"
            height="900"
            loading="eager"
            decoding="async"
        />
      </div>
    </div> : null}

  </main>
</Layout>

<script>
  const coverContainers = document.querySelectorAll(
      '.cover-image-container',
  );

  const coverModal =
      document.getElementById('cover-modal');
  const coverModalImage =
      document.getElementById('cover-modal-image');

  const hideCoverModal = () => {
    if (!coverModal) return;

    coverModal.classList.remove('is-visible');
    coverModal.setAttribute('aria-hidden', 'true');
  };

  coverContainers.forEach((container) => {
    container.addEventListener('click', () => {
      const coverImage = container.querySelector('img');
      if (!coverModal || !coverModalImage || !coverImage) return;

      coverModalImage.setAttribute('src', coverImage.currentSrc || coverImage.src);
      coverModalImage.setAttribute('alt', `${coverImage.alt} preview`);
      coverModal.classList.add('is-visible');
      coverModal.setAttribute('aria-hidden', 'false');
    });
  });

  if (coverModal) {
    coverModal.addEventListener('click', (event) => {
      const target = event.target;

      if (
          target instanceof HTMLElement &&
          (
              target === coverModal ||
              target.dataset.closeCoverModal === 'true'
          )
      ) {
        hideCoverModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        hideCoverModal();
      }
    });
  }
</script>

<style>
  .release-page {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* --------------------------------
     Release information
  -------------------------------- */

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .title-row h1 {
    margin: 0;
    line-height: 1.1;
  }


  .release-links {
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translateY(-2px);
  }

  .release-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    color: inherit;
    text-decoration: none;
    opacity: 0.55;
    transition:
        opacity 0.2s ease,
        transform 0.25s ease;
  }

  .release-link:hover {
    opacity: 1;
    transform: translateY(-3px);
  }

  .release-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .release-info {
    width: 100%;
    background: #000000;
    color: #ffffff;
  }

  .release-info-inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 24px 84px;
  }

  .release-info h1 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: lighter;
    line-height: 1.1;
  }

  .release-meta {
    margin: 4px 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .release-description {
    max-width: 700px;
    margin: 40px 0 0;
    line-height: 1.8;
    font-size: 1rem;
    opacity: 0.9;
  }

  .misc-credits {
    margin-top: 42px;
  }

  .credit-line {
    margin: 6px 0;
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.75;
  }

  .release-info .person-link {
    color: #ffffff;
  }

  /* --------------------------------
     Tracks / cover section
  -------------------------------- */

  .media-section {
    width: 100%;
  }

  .media-section-dark {
    color: #ffffff;
    background: #000000;
  }

  .media-layout {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: 72px 24px 96px;

    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
    gap: 48px;

    align-items: start;
  }

  .track-panel {
    min-width: 0;
  }

  .track-panel h2 {
    margin: 0 0 28px;
    font-size: 1.25rem;
    font-weight: lighter;
    font-style: italic;
  }

  /* --------------------------------
     Track list
  -------------------------------- */

  .track-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .track-list li {
    margin-bottom: 20px;
  }

  .track-main {
    display: grid;
    grid-template-columns: auto minmax(20px, 1fr) 3.5rem;
    column-gap: 6px;
    align-items: center;
  }

  .track-title {
    min-width: 0;
    line-height: 1.4;
  }

  .track-link {
    position: relative;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .track-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .track-link:hover {
    opacity: 0.7;
  }

  .track-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .track-dash {
    width: 100%;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }

  .track-duration {
    width: 4rem;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .track-credit {
    margin-top: 5px;
    font-size: 0.8rem;
    line-height: 1.5;
    opacity: 0.55;
    font-style: italic;
  }

  .person-link {
    color: inherit;
  }

  /* --------------------------------
     Cover
  -------------------------------- */

  .cover-panel {
    width: 100%;
  }

  .cover-image-container {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: inherit;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
  }

  .cover-image-container:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .release-cover {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: rgba(17, 17, 17, 0.08);

    transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cover-image-container:hover .release-cover {
    transform: scale(1.025);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    background: rgba(0, 0, 0, 0.32);
    color: #ffffff;

    opacity: 0;

    transition: opacity 0.25s ease;
  }

  .cover-image-container:hover .cover-overlay {
    opacity: 1;
  }

  /* --------------------------------
     Cover modal
  -------------------------------- */

  .cover-modal {
    position: fixed;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 0.2s ease,
        visibility 0.2s ease;

    z-index: 2000;
  }

  .cover-modal.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cover-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
  }

  .cover-modal-content {
    position: relative;
    z-index: 1;

    width: min(90vw, 760px);

    background: #ffffff;
    padding: 14px;

    cursor: zoom-out;
  }

  .cover-modal-image {
    display: block;

    width: 100%;
    height: auto;
    max-height: 85vh;

    object-fit: contain;
    background: rgba(17, 17, 17, 0.04);
  }

  /* --------------------------------
     Mobile
  -------------------------------- */

  @media (max-width: 700px) {
    .release-info-inner {
      padding: 56px 20px 64px;
    }

    .release-info h1 {
      font-size: 2rem;
    }

    .release-description {
      margin-top: 32px;
    }

    .misc-credits {
      margin-top: 34px;
    }

    .media-layout {
      grid-template-columns: 1fr;
      gap: 48px;

      padding: 56px 20px 72px;
    }

    .cover-panel {
      order: 2;
    }

    .track-panel {
      order: 1;
    }

    .track-main {
      grid-template-columns: minmax(0, 1fr) auto 3.5rem;
    }

    .cover-modal-content {
      width: 92vw;
      padding: 8px;
    }
  }
</style>
